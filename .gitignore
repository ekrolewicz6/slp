# Environments and caches
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.DS_Store

# Secrets
.env

# Raw / intermediate / feature data — too large to commit, and raw
# AphasiaBank / CHILDES transcripts have data-sharing restrictions
# (TalkBank Approved-Access agreement). Keep these local.
data/raw/
data/parsed/
data/features/
data/audio/
data/

# Large model checkpoints
*.bin
*.safetensors

# Outputs are committed (small CSVs + PNGs from analyses)
# but skip any oversize artifacts
*.parquet
*.zip
*.tar.gz

# Restricted / intermediate analysis artifacts derived from transcript text.
# Keep aggregate summaries in Git, but do not publish utterance-level tables,
# raw-task-text segment tables, or large generated prediction dumps.
outputs/**/*utterance*.csv
outputs/**/controller_utterances*.csv
outputs/**/task_segments.csv
outputs/**/segment_error_features.csv
outputs/**/screening_predictions.csv
outputs/**/participant_predictions*.csv
outputs/**/selected_targets_by_policy.csv
outputs/**/item_predictions.csv
outputs/**/item_observations.csv
outputs/**/noisy_state_replicates.csv
outputs/**/rescorla_windows_age_repaired.csv
outputs/**/narrative_windows.csv
outputs/**/ranked_candidates_with_scores.csv
